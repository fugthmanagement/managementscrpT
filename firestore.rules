rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function noBillingEdits() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'plan', 'status', 'planTier', 'planStatus', 'billingActive',
        'stripeCustomerId','stripeSubscriptionId', 'billingEmail'
      ]);
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && !request.resource.data.keys().hasAny([
        'plan', 'status', 'planTier', 'planStatus', 'billingActive',
        'stripeCustomerId','stripeSubscriptionId','billingEmail'
      ]);
      allow update: if owner(uid) && noBillingEdits();
      allow delete: if false;
      match /calls/{id} {
        allow read: if owner(uid);
        allow create, update, delete: if false;
      }
      match /{collectionName}/{id} {
        allow read, create, update, delete: if owner(uid) &&
          collectionName in ['leads','appointments','campaigns','knowledge','knowledgeFiles','notifications'];
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
