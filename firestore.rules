rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function protectedKeys() {
      return [
        'plan','status','planTier','planStatus','billingActive','billingEmail',
        'stripeCustomerId','stripeSubscriptionId','billingCurrentPeriodStart',
        'billingCurrentPeriodEnd','billingRenewsAt','billingExpiresAt',
        'billingCancelAtPeriodEnd','billingTrialEndsAt','billingUpdatedAt','vapiNumber','vapiPhoneNumberId',
        'vapiAssistantId','vapiLinked','vapiLinkedAt','needsVapiLink','voiceProvisionedAt',
        'assignedNumberId','assignedAssistantId'
      ];
    }
    match /users/{uid} {
      allow get, list: if isOwner(uid);
      allow create: if isOwner(uid) && !request.resource.data.keys().hasAny(protectedKeys());
      allow update: if isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedKeys());
      allow delete: if false;
      match /calls/{id} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;
      }
      match /{kind}/{id} {
        allow read, create, update, delete: if isOwner(uid) &&
          kind in ['leads','appointments','campaigns','knowledge','knowledgeFiles','notifications'];
      }
    }
    match /{path=**} { allow read, write: if false; }
  }
}